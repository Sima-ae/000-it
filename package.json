{
  "name": "000-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3066",
    "build": "next build",
    "start": "next start -p 3066",
    "lint": "eslint",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx --yes tsx prisma/seed.ts",
    "db:seed:kennisbank": "npx --yes tsx --env-file=.env prisma/seed-kennisbank.ts",
    "news:auto": "npx --yes tsx scripts/run-auto-news.ts",
    "news:backfill": "npx --yes tsx --env-file=.env scripts/backfill-auto-news.ts",
    "news:covers": "npx --yes tsx scripts/backfill-news-covers.ts",
    "news:repair": "npx --yes tsx scripts/repair-auto-news.ts",
    "news:translate": "npx --yes tsx --env-file=.env scripts/translate-news.ts",
    "kennisbank:translate": "npx --yes tsx --env-file=.env scripts/translate-kennisbank.ts",
    "kennisbank:repair": "npx --yes tsx --env-file=.env scripts/repair-kennisbank.ts",
    "content:translate": "npx --yes tsx --env-file=.env scripts/translate-content.ts",
    "generate-sitemap": "npx --yes tsx --env-file=.env scripts/generate-sitemap.ts",
    "indexnow": "npx --yes tsx --env-file=.env scripts/indexnow.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.14.3",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx --yes tsx prisma/seed.ts"
  }
}
