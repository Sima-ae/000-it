NODE_ENV=development
PORT=3066

NEXT_PUBLIC_APP_URL=http://localhost:3066
AUTH_URL=http://localhost:3066
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Local or SSH tunnel to MariaDB/MySQL — never commit real passwords
DATABASE_URL=mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app

# Optional seed passwords (defaults only work in non-production)
# SEED_SUPER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CLIENT_PASSWORD=
# ALLOW_DEMO_SEED=1
