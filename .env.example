NODE_ENV=development
PORT=3066

NEXT_PUBLIC_APP_URL=http://localhost:3066
AUTH_URL=http://localhost:3066

# Google Analytics 4 (gtag.js) — used site-wide
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1WXFSCS58G
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Local or SSH tunnel to MariaDB/MySQL — never commit real passwords
# Prefer a low connection_limit on shared DB hosts (default Prisma pool ≈ cpus*2+1).
DATABASE_URL=mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app?connection_limit=5&pool_timeout=20

# Stable IndexNow key (hex). Must match public/<KEY>.txt on the live site.
# Never rotate casually — Bing verifies https://your-host/<KEY>.txt
INDEXNOW_KEY=98510e81dcadb96dce2bc5625f3d52a3
# Optional override for sitemap/IndexNow host (defaults to https://000-it.com for sitemaps)
# SITEMAP_BASE_URL=https://000-it.com

# Optional seed passwords (defaults only work in non-production)
# SEED_SUPER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CLIENT_PASSWORD=
# ALLOW_DEMO_SEED=1

# Stripe (shop checkout — one-time payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret for POST /api/shop/webhook (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...
