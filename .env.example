NODE_ENV=development
PORT=3066

NEXT_PUBLIC_APP_URL=http://localhost:3066
AUTH_URL=http://localhost:3066

# Google Analytics 4 (gtag.js) — used site-wide
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1WXFSCS58G
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Local or SSH tunnel to MariaDB/MySQL — never commit real passwords
# Quote the URL. Prisma adds connection_limit in src/lib/prisma.ts when missing.
DATABASE_URL="mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app"

# Stable IndexNow key (hex). Must match public/<KEY>.txt on the live site.
# Never rotate casually — Bing verifies https://your-host/<KEY>.txt
INDEXNOW_KEY=98510e81dcadb96dce2bc5625f3d52a3
# Optional override for sitemap/IndexNow host (defaults to https://000-it.com for sitemaps)
# SITEMAP_BASE_URL=https://000-it.com

# Optional seed passwords (defaults only work in non-production)
# SEED_SUPER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CLIENT_PASSWORD=
# ALLOW_DEMO_SEED=1

# Outbound email (ticket replies, etc.)
# SMTP_HOST=mail.000-it.com
# SMTP_PORT=587
# SMTP_USER=support@000-it.com
# SMTP_PASS=
# SMTP_FROM="TripleZero iT Support <support@000-it.com>"

# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret for POST /api/shop/webhook (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Namecheap domain registration (XML API)
# Whitelist VPS IP: Namecheap → Profile → Tools → API Access
# Production (.env / VPS): USER + API_KEY + CLIENT_IP only — never NAMECHEAP_SSH_*
# Local only: put NAMECHEAP_SSH_PROXY / NAMECHEAP_SSH_KEY in .env.local
# NAMECHEAP_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_CLIENT_IP=89.116.38.197
# NAMECHEAP_SANDBOX=0
# CRON_SECRET=generate-with-openssl-rand-hex-32
# ADMIN_ALERT_EMAIL=info@000-it.com
