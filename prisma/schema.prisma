generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(CLIENT)
  companyName   String?
  companySize   String?
  industry      String?
  phone         String?
  interests     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects           Project[]
  clients            Client[]
  aiAgents           AIAgent[]
  payments           Payment[]
  scans              AIScan[]
  sessions           Session[]
  accounts           Account[]
  activities         Activity[]
  contactLeads       ContactLead[]         @relation("LeadSubmitter")
  portfolioProjects  PortfolioProject[]
  supportTickets     SupportTicket[]       @relation("TicketOwner")
  assignedTickets    SupportTicket[]       @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  staffTodos         StaffTodo[]
  crmNotes           CrmNote[]
  invoicesCreated    Invoice[]             @relation("InvoiceCreator")
  messagesSent       CrmMessage[]          @relation("MessageFrom")
  messagesReceived   CrmMessage[]          @relation("MessageTo")
  assignedLeads      ContactLead[]         @relation("LeadAssignee")
  newsPosts          NewsPost[]
  caseStudies        CaseStudy[]
  shopOrders         ShopOrder[]
  kennisbankArticles KennisbankArticle[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  type        ProjectType
  budget      Float?
  startDate   DateTime
  endDate     DateTime?
  progress    Int           @default(0)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients     Client[]
  aiAgents    AIAgent[]
  tasks       Task[]
  activities  Activity[]
  tickets     SupportTicket[]
  notes       CrmNote[]
  invoices    Invoice[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Client {
  id         String       @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  industry   String?
  website    String?
  address    String?      @db.Text
  city       String?
  country    String?
  vatNumber  String?
  status     ClientStatus @default(ACTIVE)
  isLead     Boolean      @default(false)
  leadSource String?
  leadStatus LeadStatus?  @default(NEW)
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      String?      @db.Text
  contacts   CrmContact[]
  crmNotes   CrmNote[]
  tickets    SupportTicket[]
  invoices   Invoice[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([isLead, leadStatus])
  @@index([email])
}

model CrmContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model CrmNote {
  id        String         @id @default(cuid())
  body      String         @db.Text
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([ticketId])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status      InvoiceStatus @default(DRAFT)
  amount      Float         @default(0)
  currency    String        @default("EUR")
  dueDate     DateTime?
  items       Json?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId, status])
}

model CrmMessage {
  id         String    @id @default(cuid())
  subject    String?
  body       String    @db.Text
  fromUserId String
  fromUser   User      @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  readAt     DateTime?
  parentId   String?
  createdAt  DateTime  @default(now())

  @@index([toUserId, readAt])
  @@index([fromUserId])
}

model AIAgent {
  id             String      @id @default(cuid())
  name           String
  type           AgentType
  status         AgentStatus @default(IDLE)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuration  Json
  tasksCompleted Int         @default(0)
  lastActive     DateTime?
  tasks          Task[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Task {
  id              String     @id @default(cuid())
  title           String
  description     String?    @db.Text
  status          TaskStatus @default(PENDING)
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgentId String?
  assignedAgent   AIAgent?   @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime     @default(now())
}

model AIScan {
  id        String     @id @default(cuid())
  url       String
  company   String?
  goals     String?    @db.Text
  scanType  ScanType   @default(FULL)
  status    ScanStatus @default(PENDING)
  results   Json?
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  currency  String        @default("EUR")
  status    PaymentStatus @default(PENDING)
  plan      String?
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ShopOrder {
  id                    String         @id @default(cuid())
  orderNumber           String         @unique
  email                 String
  name                  String
  company               String?
  locale                String         @default("nl")
  currency              String         @default("EUR")
  subtotalExcl          Float
  vatAmount             Float
  totalIncl             Float
  vatRate               Float          @default(0.21)
  status                ShopOrderStatus @default(PENDING)
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 ShopOrderItem[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model ShopOrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  name          String
  quantity      Int       @default(1)
  unitPriceIncl Float
  vatRate       Float     @default(0.21)
  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
}

model ContactLead {
  id                String     @id @default(cuid())
  name              String
  email             String
  company           String?
  message           String     @db.Text
  status            LeadStatus @default(NEW)
  source            String?    @default("CONTACT_FORM")
  assignedToId      String?
  assignedTo        User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedClientId String?
  userId            String?
  user              User?      @relation("LeadSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([assignedToId])
}

/// Marketing news / nieuws articles (DB source of truth)
/// Canonical copy is English (`title` / `excerpt` / `description`).
/// Dutch lives in `*Nl` (site default) and is mirrored in `translations.nl`.
/// Other locales: `translations` JSON map `{ [locale]: { title, excerpt, description } }`.
model NewsPost {
  id             String   @id
  title          String
  titleNl        String?
  excerpt        String   @db.Text
  excerptNl      String?  @db.Text
  date           String
  coverImage     String?  @db.Text
  description    String   @db.LongText
  descriptionNl  String?  @db.LongText
  /// Per-locale copy for all non-English languages (incl. nl).
  translations   Json?
  author         String
  projectUrl     String?
  industry       String?
  tags           Json?
  published      Boolean  @default(true)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, date])
  @@index([createdById])
}

/// Marketing case studies (DB source of truth)
model CaseStudy {
  id           String   @id
  title        String
  industry     String
  metric       String
  summary      String   @db.Text
  description  String   @db.LongText
  clientName   String
  projectUrl   String?
  coverImage   String?
  gallery      Json?
  year         Int?
  tags         Json?
  technologies Json?
  published    Boolean  @default(true)
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, year])
  @@index([createdById])
}

/// Public marketing portfolio items (not CRM "Project")
model PortfolioProject {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  summary      String   @db.Text
  description  String?  @db.LongText
  coverImage   String?
  gallery      Json?
  projectUrl   String?
  repoUrl      String?
  clientName   String?
  industry     String?
  year         Int?
  tags         Json?
  technologies Json?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([createdById])
}

/// Support / live-chat tickets (synced with CRM clients & projects)
model SupportTicket {
  id           String         @id @default(cuid())
  subject      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  source       TicketSource   @default(CHAT)
  ticketType   String?        @default("General")
  userId       String?
  user         User?          @relation("TicketOwner", fields: [userId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  guestName    String?
  guestEmail   String?
  guestToken   String?        @unique
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  notes        CrmNote[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([assignedToId])
}

model TicketMessage {
  id         String              @id @default(cuid())
  ticketId   String
  ticket     SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body       String              @db.Text
  senderId   String?
  sender     User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderKind TicketMessageSender @default(GUEST)
  createdAt  DateTime            @default(now())

  @@index([ticketId, createdAt])
}

/// Internal staff to-dos — never public, never shown to clients
model StaffTodo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, done, sortOrder])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CLIENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  CHAT
  DASHBOARD
  EMAIL
}

enum TicketMessageSender {
  GUEST
  CLIENT
  STAFF
  SYSTEM
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  WEBSITE
  SEO
  ADS
  AI_INTEGRATION
  CONTENT
  SOCIAL_MEDIA
  BRANDING
  FULL_GROWTH
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  LEAD
  LOST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum AgentType {
  SEO_AGENT
  CONTENT_AGENT
  SOCIAL_AGENT
  ADS_AGENT
  ANALYTICS_AGENT
  CHATBOT_AGENT
  RESEARCH_AGENT
}

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  TASK_COMPLETED
  AGENT_STARTED
  AGENT_COMPLETED
  CLIENT_ADDED
  SCAN_COMPLETED
  PAYMENT_RECEIVED
}

enum ScanType {
  SEO
  AEO
  GEO
  PERFORMANCE
  FULL
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ShopOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// Public knowledge base categories (Kennisbank)
model KennisbankCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  sortKey      String
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  translations KennisbankCategoryTranslation[]
  articles     KennisbankArticleCategory[]

  @@index([published, sortKey])
}

model KennisbankCategoryTranslation {
  id          String             @id @default(cuid())
  categoryId  String
  category    KennisbankCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?            @db.Text

  @@unique([categoryId, locale])
  @@index([locale])
}

model KennisbankArticle {
  id           String   @id @default(cuid())
  slug         String   @unique
  published    Boolean  @default(true)
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  translations KennisbankArticleTranslation[]
  categories   KennisbankArticleCategory[]

  @@index([published])
  @@index([createdById])
}

model KennisbankArticleTranslation {
  id             String            @id @default(cuid())
  articleId      String
  article        KennisbankArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  excerpt        String            @db.Text
  bodyHtml       String            @db.LongText
  seoTitle       String?
  seoDescription String?           @db.Text

  @@unique([articleId, locale])
  @@index([locale, title])
}

model KennisbankArticleCategory {
  articleId  String
  categoryId String
  article    KennisbankArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   KennisbankCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
}
