NODE_ENV=production
PORT=3066

NEXT_PUBLIC_APP_URL=https://000-it.com
AUTH_URL=https://000-it.com

# Google Analytics 4 (gtag.js) — used site-wide
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1WXFSCS58G
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# IndexNow key (Bing/Yandex/…). Same value as public/{KEY}.txt
# Stable IndexNow key — must match committed public/<KEY>.txt
INDEXNOW_KEY=98510e81dcadb96dce2bc5625f3d52a3

# MariaDB on the same VPS — use 127.0.0.1 (never expose publicly)
# Always quote the URL. Unquoted `&` in query params breaks `source .env` / deploy.
# connection_limit is applied in src/lib/prisma.ts when missing from the URL.
DATABASE_URL="mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app"
# Optional overrides:
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20

# Stripe (shop — one-time Checkout Sessions)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL in Stripe Dashboard: https://000-it.com/api/shop/webhook
# Events: checkout.session.completed, checkout.session.expired
