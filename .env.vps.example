NODE_ENV=production
PORT=3066

NEXT_PUBLIC_APP_URL=https://000-it.com

# MariaDB on the same VPS — use 127.0.0.1 (not the public IP)
DATABASE_URL=mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app

# Or separate vars if the password has special characters:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=000it_app
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=000it_app
