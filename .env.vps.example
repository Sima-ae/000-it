NODE_ENV=production
PORT=3066

NEXT_PUBLIC_APP_URL=https://000-it.com
AUTH_URL=https://000-it.com
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# MariaDB on the same VPS — use 127.0.0.1 (never expose publicly)
DATABASE_URL=mysql://000it_app:YOUR_PASSWORD@127.0.0.1:3306/000it_app

# Auto-news (GitHub Action calls /api/cron/auto-news)
CRON_SECRET=
OPENAI_API_KEY=
# OPENAI_NEWS_MODEL=gpt-4o-mini
